diff --git a/ik_teleop/include/ik_teleop/BIO_IK_Planner.h b/ik_teleop/include/ik_teleop/BIO_IK_Planner.h
index b008726..581f746 100755
--- a/ik_teleop/include/ik_teleop/BIO_IK_Planner.h
+++ b/ik_teleop/include/ik_teleop/BIO_IK_Planner.h
@@ -20,6 +20,20 @@
 
 #include <bio_ik/bio_ik.hpp>
 
+// control_node creates its node with automatically_declare_parameters_from_overrides(true),
+// so every parameter coming from the launch file / YAML is already declared. Calling
+// declare_parameter() again on such a name throws rclcpp::exceptions::ParameterAlreadyDeclaredException
+// (Humble behaviour) and kills the node at "Load Frequency". Only declare when still missing.
+template <typename T>
+inline void declare_parameter_if_not_declared(const rclcpp::Node::SharedPtr& node, const std::string& name,
+                                              const T& default_value)
+{
+    if (!node->has_parameter(name))
+    {
+        node->declare_parameter(name, default_value);
+    }
+}
+
 
